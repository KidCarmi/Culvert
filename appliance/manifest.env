# Culvert appliance build manifest — EVERY input the OVA is built from, pinned.
# Sourced by appliance/build.sh (bash). Change a value here, never in the scripts.
# Record of the digests actually consumed lands in <out>/build-record.json.

APPLIANCE_NAME=culvert-appliance
# Appliance build number: <application version>-ova.<N>. Bump N for a rebuild
# of the same application version (new guest image, new docker engine, ...).
APPLIANCE_VERSION=1.0.259-ova.1
APPLIANCE_ARCH=x86_64

# Guest OS: Ubuntu 24.04 LTS server cloud image, a DATED release (never
# "current" — "current" moves and the build must be reproducible).
GUEST_OS_NAME="Ubuntu 24.04 LTS (noble) server cloud image, release 20260926"
GUEST_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.img
GUEST_IMAGE_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2
GUEST_IMAGE_MANIFEST_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.manifest

# Application image: the ONLY source of truth is the signed release catalog
# (https://catalog.culvertlabs.com/release-catalog/, verified in-binary by the
# appliance and by cosign in this build). APP_IMAGE_DIGEST is the catalog
# manifest's image.list_digest for the release below; build.sh refuses to
# proceed if cosign cannot verify it against release_identity.env.
APP_VERSION=1.0.259
APP_IMAGE_REPO=ghcr.io/kidcarmi/culvert
APP_IMAGE_DIGEST=sha256:238ba99b61e1903485c4e86a2dbac33e12aa2bbc52a2861ee499f1825610347e
# Local tag given to the preloaded image so `docker load` restores the
# registry RepoDigest (an untagged save loses it — see ASTRA-STATUS.md).
APP_IMAGE_LOCAL_TAG=ghcr.io/kidcarmi/culvert:v1.0.259

# docker-compose.yml's clamav service is `clamav/clamav:1.4` by tag (not ours
# to change). The build pins the digest that tag resolved to and preloads it;
# the image bundles the signature DB so first boot needs no ClamAV mirror.
CLAMAV_IMAGE=clamav/clamav:1.4
CLAMAV_IMAGE_DIGEST=sha256:57deb108fc4c72778aa83eafbca7bb7153e28c3f57c005afd38d31f16da86f23

# Docker Engine + Compose from Docker's own apt repository (the same source
# scripts/install.sh uses), pinned to exact package versions.
DOCKER_APT_URL=https://download.docker.com/linux/ubuntu
DOCKER_APT_SUITE=noble
DOCKER_CE_VERSION="5:29.8.2-1~ubuntu.24.04~noble"
CONTAINERD_IO_VERSION="2.3.6-1~ubuntu.24.04~noble"
DOCKER_COMPOSE_PLUGIN_VERSION="5.5.1-1~ubuntu.24.04~noble"

# Build-container image used to resolve + download the .deb payload (host side).
DEB_RESOLVER_IMAGE=ubuntu:24.04

# Virtual hardware the OVF declares and the guest disk size.
VM_VCPU=2
VM_MEMORY_MB=4096
DISK_SIZE_GB=40

# Resources for the bake VM (QEMU). TCG (no KVM) needs patience, not RAM.
BAKE_VCPU=2
BAKE_MEMORY_MB=3072
BAKE_TIMEOUT_SECONDS=7200
