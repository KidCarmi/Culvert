# Culvert appliance build manifest — EVERY upstream input of the OVA is pinned
# here. Changing a pin is a reviewed change; the build refuses to run without
# every pin it needs and records the resolved values in build-info.json.
#
# Reproducibility contract (see docs/appliance/ova-build.md):
#   * input-pinned: same manifest ⇒ same base image bytes, same package versions,
#     same application image digests, same provisioning files.
#   * NOT bit-for-bit: the guest package install writes timestamps/logs, so two
#     builds of the same manifest produce OVAs with different checksums. Verify a
#     build by its build-info.json + the pins below, not by re-deriving the OVA.
#
# Shell-sourced (bash). Only KEY=VALUE lines; no command substitution.

APPLIANCE_MANIFEST_SCHEMA=1
APPLIANCE_NAME=culvert-appliance
APPLIANCE_ARCH=x86_64            # arm64 is NOT supported for the pilot
APPLIANCE_PRODUCT="Culvert Secure Web Gateway appliance"
APPLIANCE_VENDOR=KidCarmi

# ── Guest OS ────────────────────────────────────────────────────────────────
# Ubuntu 24.04 LTS (noble). Chosen for the longest support horizon available
# at pin time: standard (free) security maintenance until 2029-04 (5 years from
# 2024-04 release); Ubuntu Pro ESM extends to 2034-04. Debian 12 entered LTS-only
# maintenance in 2026-06, which is why it was not chosen.
GUEST_OS_ID=ubuntu-24.04
GUEST_OS_CODENAME=noble
GUEST_OS_NAME="Ubuntu 24.04 LTS"
GUEST_OS_STANDARD_SUPPORT_UNTIL=2029-04-30
GUEST_OS_ESM_SUPPORT_UNTIL=2034-04-30
BASE_IMAGE_SERIAL=20260926
BASE_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.img
BASE_IMAGE_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2
BASE_IMAGE_SUMS_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/SHA256SUMS
BASE_IMAGE_SUMS_SIG_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/SHA256SUMS.gpg
# "UEC Image Automatic Signing Key <cdimage@ubuntu.com>" — shipped on Ubuntu
# hosts as /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg.
BASE_IMAGE_SIGNING_KEY_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
BASE_IMAGE_KEYRING=/usr/share/keyrings/ubuntu-cloudimage-keyring.gpg

# ── Guest security updates (build time, pinned archive snapshot) ────────────
# Every package already in the base image is upgraded at build time to its
# state in this snapshot of the Ubuntu archive (snapshot.ubuntu.com,
# apt -o Acquire::Snapshot). Raising it is a reviewed pin change like any
# other; the build records what moved in build-upgrades.txt. `upgrade`, not
# dist-upgrade: no new kernel ABI is pulled in at build (see os-maintenance.md).
GUEST_APT_SNAPSHOT=20261002T120000Z

# ── Docker Engine + Compose plugin (Docker's official apt repository) ───────
DOCKER_APT_URL=https://download.docker.com/linux/ubuntu
DOCKER_APT_GPG_URL=https://download.docker.com/linux/ubuntu/gpg
# Docker Release (CE deb) <docker@docker.com>
DOCKER_APT_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
DOCKER_CE_VERSION=5:29.8.2-1~ubuntu.24.04~noble
DOCKER_CE_CLI_VERSION=5:29.8.2-1~ubuntu.24.04~noble
CONTAINERD_IO_VERSION=2.3.6-1~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.5.1-1~ubuntu.24.04~noble

# ── Application images (pulled + pre-baked BY DIGEST, loaded at first boot) ─
# The proxy image is the signed v1.0.259 release. The INDEX digest is what
# `docker pull repo@digest` resolves and what cosign signs; the amd64 digest is
# asserted against the index so a multi-arch index cannot silently change the
# platform image underneath the pin.
APP_IMAGE_REPO=ghcr.io/kidcarmi/culvert
APP_IMAGE_TAG=v1.0.259
APP_IMAGE_INDEX_DIGEST=sha256:238ba99b61e1903485c4e86a2dbac33e12aa2bbc52a2861ee499f1825610347e
APP_IMAGE_AMD64_DIGEST=sha256:f714e55b7b6708442af164accb082a3c3c89a79ecd37934931af3b166a4f448f
# ClamAV BASE image: the official 1.4.6 build, pinned by digest. The sidecar
# the appliance runs is derived from it (CLAMAV_SIDECAR_REF below).
CLAMAV_IMAGE_REPO=docker.io/clamav/clamav
CLAMAV_IMAGE_TAG=1.4
CLAMAV_IMAGE_INDEX_DIGEST=sha256:57deb108fc4c72778aa83eafbca7bb7153e28c3f57c005afd38d31f16da86f23
CLAMAV_IMAGE_AMD64_DIGEST=sha256:da8463f630e2c9467c74f3da1dee6f096e61a71650e4e9f1ff9b5f687ba91aa0
# The ClamAV sidecar the appliance RUNS, exactly as docker-compose.yml names
# it: the base above + pcre2 10.49 (CVE-2026-103111), built LOCALLY from
# appliance/clamav/Dockerfile — a local-only tag, never pulled or published.
# Its identity is the image ID the OVA build records in the guest manifest
# (CLAMAV_SIDECAR_ID) and first boot re-checks after `docker load`.
CLAMAV_SIDECAR_REF=culvert/clamav:1.4.6-pcre2-10.49

# Disposable Docker-in-Docker for the build's cold-load check
# (cold-load-check.sh): each saved archive is loaded into an EMPTY store with
# no registry and must create and run its container. Index digest of
# docker:29.6.2-dind; build host only — never baked into the guest's images.
COLDLOAD_DIND_IMAGE=docker.io/library/docker@sha256:bfec1f5159c63a81ca6fdedbd81404d2c0e16378ed0feec3bb3fbf3998847659

# ── Build-time signature verification of the proxy image (keyless cosign) ──
# Mirrors scripts/install.sh MAINT_SIGSTORE_* (pinned byte-equal to
# release_identity.env by TestReleaseIdentitySSOT). PUBLIC identity only.
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.0.6@sha256:de9c65609e6bde17e6b48de485ee788407c9502fa08b8f4459f595b21f56cd00
SIGSTORE_ISSUER=https://token.actions.githubusercontent.com
SIGSTORE_SAN_REGEX='^https://github\.com/KidCarmi/Culvert/\.github/workflows/ci\.yml@refs/tags/v.*$'

# ── Virtual hardware defaults written into the OVF ─────────────────────────
VM_VCPUS=2
VM_MEMORY_MB=4096
VM_DISK_GB=40
VM_HW_VERSION=vmx-13   # ESXi 6.5+; VirtualBox/KVM import unqualified for the pilot
