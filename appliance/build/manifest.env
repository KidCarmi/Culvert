# Culvert appliance build manifest — EVERY upstream input of the OVA is pinned
# here. Changing a pin is a reviewed change; the build refuses to run without
# every pin it needs and records the resolved values in build-info.json.
#
# Reproducibility contract (see docs/appliance/ova-build.md):
#   * input-pinned: same manifest ⇒ same base image bytes, same package versions,
#     same application image digests, same provisioning files.
#   * NOT bit-for-bit: the guest package install writes timestamps/logs, so two
#     builds of the same manifest produce OVAs with different checksums. Verify a
#     build by its build-info.json + the pins below, not by re-deriving the OVA.
#
# Shell-sourced (bash). Only KEY=VALUE lines; no command substitution.

APPLIANCE_MANIFEST_SCHEMA=1
APPLIANCE_NAME=culvert-appliance
APPLIANCE_ARCH=x86_64            # arm64 is NOT supported for the pilot
APPLIANCE_PRODUCT="Culvert Secure Web Gateway appliance"
APPLIANCE_VENDOR=KidCarmi

# ── Guest OS ────────────────────────────────────────────────────────────────
# Ubuntu 24.04 LTS (noble). Chosen for the longest support horizon available
# at pin time: standard (free) security maintenance until 2029-04 (5 years from
# 2024-04 release); Ubuntu Pro ESM extends to 2034-04. Debian 12 entered LTS-only
# maintenance in 2026-06, which is why it was not chosen.
GUEST_OS_ID=ubuntu-24.04
GUEST_OS_CODENAME=noble
GUEST_OS_NAME="Ubuntu 24.04 LTS"
GUEST_OS_STANDARD_SUPPORT_UNTIL=2029-04-30
GUEST_OS_ESM_SUPPORT_UNTIL=2034-04-30
BASE_IMAGE_SERIAL=20260926
BASE_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.img
BASE_IMAGE_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2
BASE_IMAGE_SUMS_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/SHA256SUMS
BASE_IMAGE_SUMS_SIG_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/SHA256SUMS.gpg
# "UEC Image Automatic Signing Key <cdimage@ubuntu.com>" — shipped on Ubuntu
# hosts as /usr/share/keyrings/ubuntu-cloudimage-keyring.gpg.
BASE_IMAGE_SIGNING_KEY_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
BASE_IMAGE_KEYRING=/usr/share/keyrings/ubuntu-cloudimage-keyring.gpg

# ── Guest security updates (build time, pinned archive snapshot) ────────────
# Every Ubuntu package the build installs or upgrades comes from this snapshot
# of the Ubuntu archive (snapshot.ubuntu.com, `apt-get --snapshot ID`, with the
# Ubuntu sources opted in via `Snapshot: yes`; see apt-snapshot.sh). Raising it
# is a reviewed change of FIVE values: the ID and the SHA-256 of each suite's
# snapshot InRelease below. The ID alone proves nothing (a wrong or future ID
# is served as the archive's current state), so the build refuses an InRelease
# that differs from its pin, and build-ova.sh then reconciles every installed
# package against these indexes (package-provenance.tsv). The build records
# what moved in build-upgrades.txt. `upgrade --with-new-pkgs`: the kernel
# moves to the snapshot's newest ABI at build and the superseded kernel is
# purged (see ova-build.md).
#
# OVAs built before FB-1 (including 325c142a) passed `-o Acquire::Snapshot`,
# which APT ignores: they were built from the LIVE archive of their build day
# (docs/appliance/evidence/combined/future-build/FB-1-APT-SNAPSHOT.md).
#
# 20261029T180000Z (selected 31 Oct, FB-1 pin raise): its four InRelease files
# are byte-identical to the indexes the owner-approved kernel 7.0.0-38 -> 42
# transaction was evaluated against (esxi-325c142a/kernel-42/apt-indexes.txt),
# it resolves linux-image-virtual-hwe-24.04 to exactly 7.0.0-42.42~24.04.1,
# and against the retained 325c142a inventory it predicts no downgrade and no
# version outside the snapshot (future-build/fb1-snapshot-20261029/).
# The previous pin 20261002T120000Z would have shipped OLDER versions than
# 325c142a for 57 packages. The build start is not a manifest value:
# build-ova.sh records it once and hands it to the guest
# (GUEST_APT_BUILD_START); the ID must be strictly earlier.
GUEST_APT_SNAPSHOT=20261029T180000Z
# gpgv-verified against the Ubuntu archive key F6ECB3762474EDA9D21B7022871920D1991BC93C,
# each fetched twice byte-identical (fb1-snapshot-20261029/authn.tsv).
GUEST_APT_SNAPSHOT_INRELEASE_SHA256_NOBLE=cdb2f31d809f589719a53c6ad15f255b27569c4059542ada282aaa21b8e164b0
GUEST_APT_SNAPSHOT_INRELEASE_SHA256_UPDATES=1af76bea40c6b8ddbc51a51046c5a3e7912c9611536e97afc673a4b1c39d1886
GUEST_APT_SNAPSHOT_INRELEASE_SHA256_SECURITY=d90e89008640e66a6eacc13ffaad0fbbd205877cc51acdd8d4f99f9d21fcfee0
GUEST_APT_SNAPSHOT_INRELEASE_SHA256_BACKPORTS=b6a0b10bb67d8da7ecb72a3f62dda5f408091d5a1abe8cbda2380f4af6b705cd

# ── Guest kernel: Ubuntu's supported HWE series ─────────────────────────────
# The GA 24.04 kernel (6.8.0) carried 5 CRITICAL and 138 HIGH CVEs still open
# in Canonical's tracker at the 7c7b29ee scan (no fixed 6.8.0 package); the
# HWE kernel of that scan (7.0.0-38, linux-hwe-7.0 — the 26.04 kernel
# backported to 24.04, Canonical-supported for the rest of 24.04's life)
# carried 0 CRITICAL and 23 HIGH. The current pin resolves 7.0.0-42.42~24.04.1,
# the owner-approved kernel-42 disposition (esxi-325c142a/kernel-42/). The IMAGE metapackage only: it tracks
# kernel security updates (culvert-os-update / unattended-upgrades) without
# shipping kernel headers the appliance never uses. The build removes the GA
# metapackage chain so it cannot pull the 6.8 ABI back.
GUEST_KERNEL_META=linux-image-virtual-hwe-24.04

# ── Docker Engine + Compose plugin (Docker's official apt repository) ───────
DOCKER_APT_URL=https://download.docker.com/linux/ubuntu
DOCKER_APT_GPG_URL=https://download.docker.com/linux/ubuntu/gpg
# Docker Release (CE deb) <docker@docker.com>
DOCKER_APT_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
# Engine 29.9.2 is built with go1.26.10 and containerd.io 2.4.2-3 with go1.27.3:
# the exact-byte scan of OVA 61c46d6d (29.9.0 / go1.26.9, containerd.io 2.4.1-2 /
# go1.27.2) found crypto/x509 GO-2026-6809 (CVE-2026-111943) reachable in
# dockerd, docker, containerd and ctr. The REVISION matters: containerd.io
# 2.4.2-1 and -2 are older builds; only -3 is go1.27.3. Binary-mode govulncheck
# of the signed DEBs: GO-2026-6809 absent in all seven engine binaries, every
# other row unchanged (containerd/runc still carry x/net < v0.60.0) —
# docs/appliance/evidence/combined/m1-engine-pins/.
# Compose 5.6.1 (go1.26.10, x/net v0.58.0) removes every stdlib finding the
# exact-byte scan of 5.6.0 (go1.26.8) carried; it is NOT zero-finding (x/net
# GO-2026-6610 package-level, x/crypto openpgp GO-2026-5932 module-level, no fix)
# — docs/appliance/r6-r7-security-dispositions.md. Installed from the same
# signed apt repository as the engine (key above); on the appliance it only ever
# runs `up --no-build`, so the build path that carries the remaining reachable
# x/net rows is not used.
DOCKER_CE_VERSION=5:29.9.2-1~ubuntu.24.04~noble
DOCKER_CE_CLI_VERSION=5:29.9.2-1~ubuntu.24.04~noble
CONTAINERD_IO_VERSION=2.4.2-3~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.6.1-1~ubuntu.24.04~noble
# The .deb SHA-256 of each pinned Docker package (FB-1). Docker's repository
# has no snapshots, so a version pin alone does not bind the bytes: the guest
# refuses an acquired .deb whose hash differs, and build-ova.sh refuses a
# Docker index that lists another hash for the pinned version. Each value was
# read from Docker's gpgv-verified index AND hashed from the downloaded .deb
# (31 Oct), and the three engine values equal M1's (m1-engine-pins/lab/identities.txt).
DOCKER_CE_DEB_SHA256=95ddf7a2d8b8c0eb82d8597d4d604e294dcf741081f2e228524d5ab9bfd7c8ae
DOCKER_CE_CLI_DEB_SHA256=74747b5c99000279b9b2c7eb82543b4121d8436a58aa3be7e78ac6681d74794f
CONTAINERD_IO_DEB_SHA256=f811ab57d1f4bb0cce19df7d526da8c711d8ebea0447cc83da1999188e664122
DOCKER_COMPOSE_PLUGIN_DEB_SHA256=9725be1df7fd5ccc6b21ac24112885896c8d134345e3f4aa20b3c2064ef4620e

# ── Application images (pulled + pre-baked BY DIGEST, loaded at first boot) ─
# The proxy image is the signed v1.0.259 release. The INDEX digest is what
# `docker pull repo@digest` resolves and what cosign signs; the amd64 digest is
# asserted against the index so a multi-arch index cannot silently change the
# platform image underneath the pin.
APP_IMAGE_REPO=ghcr.io/kidcarmi/culvert
APP_IMAGE_TAG=v1.0.259
APP_IMAGE_INDEX_DIGEST=sha256:238ba99b61e1903485c4e86a2dbac33e12aa2bbc52a2861ee499f1825610347e
APP_IMAGE_AMD64_DIGEST=sha256:f714e55b7b6708442af164accb082a3c3c89a79ecd37934931af3b166a4f448f
# ClamAV BASE image: the official 1.4.6 build, pinned by digest. The sidecar
# the appliance runs is derived from it (CLAMAV_SIDECAR_REF below).
CLAMAV_IMAGE_REPO=docker.io/clamav/clamav
CLAMAV_IMAGE_TAG=1.5
CLAMAV_IMAGE_INDEX_DIGEST=sha256:638d90201ee7ee6a82d249a2fc23b132e578673b5f1f2766852b127676ca1ef6
CLAMAV_IMAGE_AMD64_DIGEST=sha256:705e0723f02fc13bf6e5e8a8e13a8c44420acf5e7ed06dfa2197081da00c7a73
# The ClamAV sidecar the appliance RUNS, exactly as docker-compose.yml names
# it: the base above + pcre2 10.49 (CVE-2026-103111), zlib 1.3.2-r1
# (CVE-2026-85091), nghttp2-libs 1.70.0-r0 (CVE-2026-58055), musl/musl-utils
# 1.2.6-r3 (CVE-2026-107891), brotli-libs 1.2.1-r0 (CVE-2026-111497) and
# libcurl 8.23.0-r0 (CVE-2026-92392), built LOCALLY from
# appliance/clamav/Dockerfile — a local-only tag, never pulled or published.
# Its identity is the image ID the OVA build records in the guest manifest
# (CLAMAV_SIDECAR_ID) and first boot re-checks after `docker load`.
# The tag changes with every content change: Compose builds the sidecar only
# when this tag is absent locally. (Previous: 1.5.4-culvert.3, without libcurl 8.23.0-r0.)
CLAMAV_SIDECAR_REF=culvert/clamav:1.5.4-culvert.4

# Disposable Docker-in-Docker for the build's cold-load check
# (cold-load-check.sh): each saved archive is loaded into an EMPTY store with
# no registry and must create and run its container. Index digest of
# docker:29.6.2-dind; build host only — never baked into the guest's images.
COLDLOAD_DIND_IMAGE=docker.io/library/docker@sha256:bfec1f5159c63a81ca6fdedbd81404d2c0e16378ed0feec3bb3fbf3998847659

# ── Build-time signature verification of the proxy image (keyless cosign) ──
# Mirrors scripts/install.sh MAINT_SIGSTORE_* (pinned byte-equal to
# release_identity.env by TestReleaseIdentitySSOT). PUBLIC identity only.
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.0.6@sha256:de9c65609e6bde17e6b48de485ee788407c9502fa08b8f4459f595b21f56cd00
SIGSTORE_ISSUER=https://token.actions.githubusercontent.com
SIGSTORE_SAN_REGEX='^https://github\.com/KidCarmi/Culvert/\.github/workflows/ci\.yml@refs/tags/v.*$'

# ── Virtual hardware defaults written into the OVF ─────────────────────────
VM_VCPUS=2
VM_MEMORY_MB=4096
VM_DISK_GB=40
VM_HW_VERSION=vmx-13   # ESXi 6.5+; VirtualBox/KVM import unqualified for the pilot
