#!/bin/sh
# initramfs init-premount: the line under the Culvert splash, or no splash at
# all on a machine with no display.
#
# With a display: the line is truthful for the whole time the splash is shown
# (it ends when the console menu starts) and names the key that shows the boot
# messages, under the title in the theme's blue. Not a "keys:" message:
# ubuntu-text puts those four rows from the bottom.
#
# With no display controller (a serial-only VM): nobody can see the splash, but
# while it is shown ubuntu-text switches kernel console output off for every
# console, serial included, and Plymouth captures systemd's status lines. So
# end Plymouth here and the serial console carries the whole boot. The kernel
# registers its VGA text console even with no adapter, so the console driver
# cannot tell the two apart; a PCI display-class device (0x03xxxx) can.
#
# Best-effort: never blocks the boot.
PREREQ="plymouth"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
command -v plymouth >/dev/null 2>&1 || exit 0
plymouth --ping 2>/dev/null || exit 0
sysfs="${CULVERT_SPLASH_SYSFS:-/sys}"
display=0
for class in "$sysfs"/bus/pci/devices/*/class; do
    [ -r "$class" ] || continue
    case "$(cat "$class" 2>/dev/null)" in 0x03*) display=1; break ;; esac
done
if [ "$display" = 0 ]; then
    plymouth quit 2>/dev/null || true
    exit 0
fi
plymouth display-message --text="Starting system services  -  Esc: boot messages" 2>/dev/null || true
exit 0
