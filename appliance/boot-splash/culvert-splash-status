#!/bin/sh
# Keep the boot-console status line and key hint visible in the REAL root.
#
# culvert-splash-message sets the line in the initramfs, but once the real
# root's plymouth-start takes the splash over the line is gone, leaving the
# ~50 s service-start wait as title + dots with no status, no key hint and no
# warning when a service fails (owner report, #1528). This runs after
# plymouth-start and re-asserts the line, refreshing it so a theme redraw on
# boot progress cannot drop it, and switches to a failure warning if a unit
# has failed. It exits by itself when Plymouth quits (the console menu starts),
# so it needs no explicit stop. Best-effort throughout; a machine with no
# display never reaches here (ExecCondition=culvert-has-display on the unit).
#
# /bin/sh is dash on Ubuntu: POSIX only. ASCII only — the console is VGA text
# (nomodeset), where non-ASCII (an em dash) does not render.
set -u
command -v plymouth >/dev/null 2>&1 || exit 0
ok='Starting system services  -  Esc: boot messages'
# The failure line is: fail_prefix + body (the failed-unit summary) + fail_hint.
# It is assembled from these two literals so the width budget below is DERIVED
# from them and cannot drift if either string is edited. ASCII only (VGA text,
# nomodeset).
fail_prefix='Service failed: '
fail_hint='  -  Esc or Alt+F12: boot log'
# Width left for the body so the WHOLE line fits the 80-column VGA console.
# #1528 ASTRA: the old code bounded only the unit NAME to 40 chars and ignored
# the prefix (16), the "(+N more)" count and the hint (29), so a 40-char unit
# emitted a 95-column line. Budget the entire line instead.
body_max=$(( 80 - ${#fail_prefix} - ${#fail_hint} ))

# failed_units_summary prints the first failed unit's name plus a "(+N more)"
# count when several have failed, with the WHOLE body bounded to body_max so
# that fail_prefix + body + fail_hint never exceeds 80 columns for ANY name
# length or failure count. A generic "a service failed" told the operator
# nothing actionable (#1528 ASTRA: the failed unit was journal-proven but its
# NAME was absent from the progress frame); naming the unit points them at the
# right `journalctl -u <unit>` / Alt+F12 log. Best-effort: on any error or no
# names it prints nothing and the caller falls back to the generic warning.
failed_units_summary() {
    _u=$(systemctl list-units --state=failed --no-legend --plain --no-pager 2>/dev/null \
        | awk '{print $1}' | grep -c .)
    _first=$(systemctl list-units --state=failed --no-legend --plain --no-pager 2>/dev/null \
        | awk 'NR==1{print $1}')
    [ -n "$_first" ] || return 0
    # Build the count suffix FIRST, then give the unit name whatever width is
    # left of the body budget — so the count is never truncated and the TOTAL
    # (prefix + name + suffix + hint) stays within 80 columns.
    if [ "${_u:-0}" -gt 1 ]; then
        _suffix=" (+$((_u - 1)) more)"
    else
        _suffix=""
    fi
    _name_max=$(( body_max - ${#_suffix} ))
    [ "$_name_max" -lt 1 ] && _name_max=1
    _first=$(printf "%.${_name_max}s" "$_first")
    printf '%s%s' "$_first" "$_suffix"
}

while plymouth --ping 2>/dev/null; do
    # Gate on an ACTUAL failed unit, not on is-system-running. A unit that fails
    # during boot is in "failed" state (listed by `list-units --state=failed`)
    # immediately, but `is-system-running` stays "starting" until the default
    # target completes — which is ~when Plymouth quits. Gating the warning on
    # "degraded" therefore left the whole splash window showing the OK line while
    # a unit had already failed (#1528: a lab VGA capture showed exactly that —
    # "Starting system services" on screen while a unit had failed at boot).
    # failed_units_summary is the authoritative signal and works while "starting".
    units=$(failed_units_summary)
    if [ -n "$units" ]; then
        msg="$fail_prefix$units$fail_hint"
    elif [ "$(systemctl is-system-running 2>/dev/null)" = degraded ]; then
        # Degraded but the unit list is momentarily unavailable: still warn.
        msg='A service failed to start  -  Esc or Alt+F12: boot log'
    else
        msg=$ok
    fi
    plymouth display-message --text="$msg" 2>/dev/null || true
    sleep 2
done
exit 0
