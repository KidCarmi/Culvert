+	p.registry.profiles, p.registry.live = p.next.profiles, p.next.live
+	p.registry.mu.Unlock()
+	p.done = true
+	p.registry.txnMu.Unlock()
+}
+
+func (p *preparedIdPReplacement) Abort() {
+	if p == nil || p.done {
+		return
+	}
+	p.done = true
