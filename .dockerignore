.github
.golangci.yml
.dockerignore
# Local credentials, lab artifacts and assistant caches never enter builders.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/.tools
**/.codex
**/.claude
**/.ssh
**/.aws
**/.azure
**/.kube
**/.npmrc
**/.netrc
**/__pycache__
**/*.ova
**/*.vmdk
**/*.qcow2
**/*.credential.xml
deploy
# docker-compose*.yml stays IN the build context: the Dockerfile copies the
# compose files into the /app/deploy bundle for source-free installs.
*.md
*.out
coverage.*
*_test.go
testdata
fuzz_test.go
# Frontend (FE-1A): the Go/docker build consumes only the committed
# frontend/dist (embedded in FE-1B); dependency trees stay out of the context.
frontend/node_modules
frontend/tools/openapi-gen/node_modules
