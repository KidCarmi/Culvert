  "title": "Allow-all-with-webmail-carveout (category exception above broad permit)",
  "administrator_requirement": "Permit all egress but block the 'webmail' category via a higher-priority rule; verifies priority-0 category block wins over a priority-1 allow-all.",
  "enterprise_validity_rationale": "Layered allow-with-exceptions using categories is a very common enterprise shape.",
  "comparable_product_capability": "Rule ordering + category",
  "capabilities": [
    "rule_first_match",
    "url_categories",
    "rule_ordering",
    "http"
  ],
  "semantic_fingerprint": "25b593e4b3e844e8",
  "notes": "",
  "preconditions": {
    "baseline": "fresh /data + open-mode",
    "fixtures": "local origin_server on 192.0.2.2 (HTTP 18091 / HTTPS 18453), /etc/hosts routing",
    "network_topology": "single-node Culvert; TEST-NET-1 fixture; two client sources (192.0.2.2 corp / 127.0.0.1 guest)",
    "requires_auth": false
  },
  "intent": {
    "default_action": "deny",
    "default_auth": "Exempt",
    "objects": {
      "categories": {
        "webmail": [
          "example.test"
        ]
      }
    },
    "rules": [
      {
        "name": "permit-corp",
        "priority": 1,
        "kind": "access",
        "match": {
          "fqdn": "*"
        },
        "action": "allow"
      },
      {
        "name": "block-webmail",
        "priority": 0,
        "kind": "access",
        "match": {
          "category": "webmail"
        },
        "action": "block_page"
      }
    ],
    "triage": {
      "class": "CONFIGURATION_CONTRACT_GAP",
      "note": "The admin set the category-exception rule to priority 0 intending TOP precedence (a common '0 = highest' convention), but Culvert treats priority 0 as the Go zero-value 'unset' and silently auto-assigns it to the END (persisted as priority 2, BELOW the priority-1 allow-all). The config is accepted with NO warning, so the intended precedence is silently INVERTED and the exception never fires. Priority 0 is unusable as a top-priority value; the coercion is not surfaced. (The same layering works correctly with priorities >=1 \u2014 see the precedence family, which passes.)"
    }
  },
