culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker compose -f {compose_path} --profile cli run --rm -e CULVERT_BACKUP_PASSPHRASE cli --restore /backup/* --mode state-only --allow-counter-rollback --confirm
