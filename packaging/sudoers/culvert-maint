culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker compose -f {compose_path} --profile cli run --rm -e CULVERT_BACKUP_PASSPHRASE cli --restore /backup/* --mode trust-root-only --accept-dp-reenrollment --confirm
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker compose -f {compose_path} --profile cli run --rm -e CULVERT_BACKUP_PASSPHRASE cli --restore /backup/* --mode trust-root-only --allow-counter-rollback --confirm
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker compose -f {compose_path} --profile cli run --rm -e CULVERT_BACKUP_PASSPHRASE cli --restore /backup/* --mode trust-root-only --accept-dp-reenrollment --allow-counter-rollback --confirm
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker compose -f {compose_path} --profile cli run --rm -e CULVERT_BACKUP_PASSPHRASE cli --restore /backup/* --mode state-only --confirm
