# ─── image / manifest inspect (upgrade check, read-only) ────────────
# Single bounded `*` = the image_ref token, validated against
# image_allowlist + an argv-safety shape before sudo is invoked. These
# are global (non-compose) docker reads; they cannot mutate the stack.
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker image inspect *
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker manifest inspect --verbose *

# ─── container inspect (upgrade-apply capture primitive, read-only) ──
# Reads the running proxy container's image config digest so the apply
# slice can capture what is ACTUALLY running (not what a tag resolves to
# locally). Read-only: it cannot pull, restart, or mutate the stack, and
# /v1/upgrades/apply is NOT activated by the slice that adds these lines.
#
# These entries are ENUMERATED, not wildcarded: one fixed-length
# [0-9a-f] pattern per legal container-id length (12–64 = 53 lines).
# There is deliberately NO trailing `*` — sudo's `*` matches whitespace,
# so a single `… "{{json .Image}}" *` rule would also admit extra args
# after the id (e.g. a second `--format {{json .Config.Env}}`, which
# docker honors as the last --format), letting a direct sudo call dump
# arbitrary container env/secrets as root. Enumerating fixed-length hex
# classes bounds the rule to exactly one id of an allowed length and
# nothing more, and keeps `--format` locked to `{{json .Image}}`. Same
# "enumerate, never broaden for readability" rule as the restore flags.
# The `--format` value is double-quoted because `{{json .Image}}` is ONE
# argv token containing a space; without the quotes sudo would parse it
# as two arguments and never match the agent's single-token argv.
# The lengths MUST match containerIDMinLen..containerIDMaxLen in
# internal/runner/templates_upgrade.go (the parity test enforces it).
culvert-maint ALL=(root) NOPASSWD: /usr/bin/docker inspect --format "{{json .Image}}" [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]
