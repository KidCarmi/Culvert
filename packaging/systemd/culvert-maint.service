# Culvert Maintenance Agent (D1.6a)
#
# Host-side systemd service that exposes a Unix-domain-socket API for
# the CP/GUI to drive backup, restore, cleanup, and (later) upgrade
# operations against the Culvert Docker Compose stack.
#
# D1.6a is the foundation slice: read-only API only. State-changing
# operations (backup/restore/cleanup/upgrade/rollback) land in
# D1.6b/c.
#
# Install: see packaging/culvert-maint/install.sh
#
# This unit runs as the unprivileged `culvert-maint` user. The agent
# never runs as root. All Docker operations are gated through either
# (a) sudoers + path-bound allowlist (production default), or
# (b) docker group membership (dev/lab opt-in; effectively root-equiv).
# See /etc/culvert-maint/config.toml `privilege_mode` and `allow_peers`.
#
# IMPORTANT — NoNewPrivileges (learned in the field, 2026-07):
#   privilege_mode=sudoers (the production default) requires the agent
#   to call `sudo -n docker compose ...`, and sudo's setuid escalation
#   does not work under PR_SET_NO_NEW_PRIVS. Merely omitting
#   `NoNewPrivileges=true` is NOT enough: for a non-root (User=) service,
#   systemd IMPLIES NoNewPrivileges whenever any seccomp-backed sandbox
#   option is used (SystemCallFilter/SystemCallArchitectures,
#   MemoryDenyWriteExecute, RestrictRealtime, RestrictSUIDSGID,
#   LockPersonality, RestrictNamespaces, PrivateDevices,
#   ProtectKernelTunables/Modules/Logs, ProtectClock, ProtectHostname),
#   because installing a seccomp filter without CAP_SYS_ADMIN requires
#   PR_SET_NO_NEW_PRIVS — sudo then fails with 'the "no new privileges"
#   flag is set' and EVERY Docker operation breaks (the socket/API keep
#   working, so the failure only surfaces on the first privileged op).
#   Likewise, an empty CapabilityBoundingSet= is inherited across exec,
#   so even setuid-root sudo would compute an EMPTY capability set.
#   This unit therefore keeps only mount-namespace / fd-level hardening
#   (no seccomp options, no capability clamp). The trade-off is bounded:
#   the sudoers allowlist (/etc/sudoers.d/culvert-maint) is the
#   privilege boundary. If `privilege_mode=docker_group_lab` is in use
#   (dev/lab only — no sudo involved), operators may re-add
#   `NoNewPrivileges=true` and the seccomp options via a drop-in
#   (/etc/systemd/system/culvert-maint.service.d/*.conf).

[Unit]
Description=Culvert Maintenance Agent
Documentation=https://github.com/KidCarmi/Culvert/blob/main/roadmap/D1.6-maintenance-agent-implementation-plan.md
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=culvert-maint
Group=culvert-maint

# allow_peers is now a config-only key (see /etc/culvert-maint/config.toml).
# There is NO --allow-peers flag — operators have one config surface.
ExecStart=/usr/local/bin/culvert-maint --config /etc/culvert-maint/config.toml

Restart=on-failure
RestartSec=5s

# ── Hardening (mount-namespace / fd-level ONLY — see header comment) ───────
# No seccomp-backed options here: for a User= service they would imply
# NoNewPrivileges and break setuid sudo (privilege_mode=sudoers). Explicit
# NoNewPrivileges=no documents the requirement; it cannot override an
# implication, which is why the seccomp options must stay absent.
NoNewPrivileges=no
# ProtectSystem=strict (mounts the whole hierarchy read-only except /dev /proc
# /sys and ReadWritePaths) is SAFE with privilege_mode=sudoers, and recovers the
# read-only /var, /etc and /run that ProtectSystem=full did not cover:
#   • ProtectSystem is mount-namespace based — it NEVER implies NoNewPrivileges,
#     so it does not affect setuid sudo (unlike the seccomp options above).
#   • NOPASSWD `sudo -n` (how the runner invokes docker) performs NO credential
#     caching, so it writes no timestamp under /run/sudo — the one concern that
#     motivated the earlier downgrade to =full. The ReadWritePaths below keep the
#     sudo timestamp dirs writable anyway (tolerant `-` prefix) for any sudo build
#     that touches them, belt-and-suspenders.
#   • The agent's `sudo docker compose …` children inherit this mount namespace,
#     but the docker CLI only connects to the daemon socket (a connect(), allowed
#     on a read-only mount) and writes only to $HOME=/var/lib/culvert-maint (in
#     ReadWritePaths); the actual container/volume writes happen in the UNsandboxed
#     dockerd, outside this unit. So `up`/`down`/`ps`/pull all work under strict.
# NOTE: this interacts with the sudo↔systemd path that caused the original field
# failure; keep the install-lifecycle e2e exercising a real privileged agent op.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid

# RuntimeDirectory creates /run/culvert-maint owned by the service user at
# start, so the unprivileged agent can bind its UDS at
# /run/culvert-maint/culvert-maint.sock. It cannot create a socket directly in
# root-owned /run. The directory is automatically in the writable set.
RuntimeDirectory=culvert-maint
RuntimeDirectoryMode=0755
# Preserve the directory inode across restarts. The Release Management opt-in
# (docker-compose.maint-agent.yml) bind-mounts /run/culvert-maint into the proxy
# container; with the default Preserve=no, systemd would delete + recreate the
# dir (new inode) on every restart — including the frequent Restart=on-failure —
# leaving the proxy's mount pointing at the old inode and Release Management back
# at "Agent unreachable". The agent removes any stale socket file on start.
RuntimeDirectoryPreserve=yes

# Writable paths the agent needs (beyond RuntimeDirectory above):
#  - /var/lib/culvert-maint for state (audit log, op logs)
ReadWritePaths=/var/lib/culvert-maint

# Capability bounding set: DELIBERATELY not clamped. The bounding set is
# inherited across exec, so `CapabilityBoundingSet=` (empty) would leave a
# setuid-root sudo with an empty capability set and break privilege_mode=
# sudoers (see header). The agent process itself still runs as the
# unprivileged culvert-maint user with no ambient capabilities.
AmbientCapabilities=

# Resource sanity.
LimitNOFILE=4096
TasksMax=64

[Install]
WantedBy=multi-user.target
