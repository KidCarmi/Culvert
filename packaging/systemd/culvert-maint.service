# Culvert Maintenance Agent (D1.6a)
#
# Host-side systemd service that exposes a Unix-domain-socket API for
# the CP/GUI to drive backup, restore, cleanup, and (later) upgrade
# operations against the Culvert Docker Compose stack.
#
# D1.6a is the foundation slice: read-only API only. State-changing
# operations (backup/restore/cleanup/upgrade/rollback) land in
# D1.6b/c.
#
# Install: see packaging/culvert-maint/install.sh
#
# This unit runs as the unprivileged `culvert-maint` user. The agent
# never runs as root. All Docker operations are gated through either
# (a) sudoers + path-bound allowlist (production default), or
# (b) docker group membership (dev/lab opt-in; effectively root-equiv).
# See /etc/culvert-maint/config.toml `privilege_mode` and `allow_peers`.
#
# IMPORTANT — NoNewPrivileges:
#   This unit deliberately does NOT set `NoNewPrivileges=true`.
#   privilege_mode=sudoers (the production default) requires the agent
#   to call `sudo -n docker compose ...`, and sudo's setuid escalation
#   does not work under PR_SET_NO_NEW_PRIVS. The trade-off is bounded:
#   the sudoers allowlist (/etc/sudoers.d/culvert-maint) is the
#   privilege boundary, and the kernel-level hardening below still
#   applies. If `privilege_mode=docker_group_lab` is in use, operators
#   may add `NoNewPrivileges=true` via a drop-in
#   (/etc/systemd/system/culvert-maint.service.d/*.conf) — but
#   docker_group_lab is dev/lab only.

[Unit]
Description=Culvert Maintenance Agent
Documentation=https://github.com/KidCarmi/Culvert/blob/main/roadmap/D1.6-maintenance-agent-implementation-plan.md
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=culvert-maint
Group=culvert-maint

# allow_peers is now a config-only key (see /etc/culvert-maint/config.toml).
# There is NO --allow-peers flag — operators have one config surface.
ExecStart=/usr/local/bin/culvert-maint --config /etc/culvert-maint/config.toml

Restart=on-failure
RestartSec=5s

# ── Hardening (kernel-level, applies regardless of privilege_mode) ─────────
# NoNewPrivileges intentionally omitted — see header comment.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid

# RuntimeDirectory creates /run/culvert-maint owned by the service user at
# start (and removes it on stop), so the unprivileged agent can bind its UDS
# at /run/culvert-maint/culvert-maint.sock. It cannot create a socket directly
# in root-owned /run. The directory is automatically in the writable set.
RuntimeDirectory=culvert-maint
RuntimeDirectoryMode=0755

# Writable paths the agent needs (beyond RuntimeDirectory above):
#  - /var/lib/culvert-maint for state (audit log, op logs)
ReadWritePaths=/var/lib/culvert-maint

# Capability set: empty by default. The agent does not need any
# capabilities to do its own work; sudo / docker provides the
# privilege when needed.
CapabilityBoundingSet=
AmbientCapabilities=

# Resource sanity.
LimitNOFILE=4096
TasksMax=64

[Install]
WantedBy=multi-user.target
