+func importChecksumTypes(info *nfc.LeaseInfo, manifest map[string]*library.Checksum) ([]types.KeyValue, error) {
+	var pairs []types.KeyValue
+	for _, item := range info.Items {
+		sum := manifest[item.Path]
+		if sum == nil {
+			return nil, fmt.Errorf("missing checksum for %s", item.Path)
+		}
+		algorithm := strings.ToLower(sum.Algorithm)
+		if algorithm != "sha1" && algorithm != "sha256" {
+			return nil, fmt.Errorf("unsupported checksum algorithm %s", algorithm)
+		}
+		matches := 0
+		for _, device := range info.DeviceUrl {
+			if device.ImportKey == item.DeviceId {
+				pairs = append(pairs, types.KeyValue{Key: device.Key, Value: algorithm})
+				matches++
+			}
+		}
+		if matches != 1 {
+			return nil, fmt.Errorf("expected one lease device for %s", item.Path)
+		}
+	}
+	return pairs, nil
+}
