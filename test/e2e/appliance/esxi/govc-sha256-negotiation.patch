index 0000000..740c92f
--- /dev/null
+++ b/ovf/importer/stream_checksum_local_test.go
@@ -0,0 +1,52 @@
+package importer
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"github.com/vmware/govmomi/vapi/library"
+	"testing"
+)
+
+func TestLocalStreamChecksum(t *testing.T) {
+	// Header, one grain, EOS, optional zero padding. Not a bootable image.
+	data := make([]byte, 2048)
+	le := binary.LittleEndian
+	le.PutUint32(data[0:4], 0x564d444b)
+	le.PutUint32(data[4:8], 3)
+	le.PutUint32(data[8:12], 0x30003)
+	le.PutUint64(data[12:20], 128)
+	le.PutUint64(data[20:28], 128)
+	le.PutUint64(data[64:72], 1)
+	le.PutUint16(data[77:79], 1)
+	le.PutUint32(data[520:524], 1)
+	data[524] = 42
+	manifest := func(b []byte) *library.Checksum {
+		return &library.Checksum{Algorithm: "SHA256", Checksum: fmt.Sprintf("%x", sha256.Sum256(b))}
+	}
+	result, err := verifiedStreamChecksum(bytes.NewReader(data), int64(len(data)), manifest(data))
+	if err != nil || result.Checksum != manifest(data[:1536]).Checksum {
+		t.Fatalf("stream digest: %v %v", result, err)
+	}
+	if _, err := verifiedStreamChecksum(bytes.NewReader(data), int64(len(data)), manifest(data[:1536])); err == nil {
+		t.Fatal("full-file corruption accepted")
+	}
+	data[2047] = 1
+	if _, err := verifiedStreamChecksum(bytes.NewReader(data), int64(len(data)), manifest(data)); err == nil {
+		t.Fatal("nonzero trailing data accepted")
+	}
+	data[2047] = 0
+	data[1024] = 1
+	if _, err := verifiedStreamChecksum(bytes.NewReader(data), int64(len(data)), manifest(data)); err == nil {
+		t.Fatal("non-EOS marker accepted")
+	}
+	data[1024] = 0
+	if _, err := verifiedStreamChecksum(bytes.NewReader(data[:1000]), 1000, manifest(data[:1000])); err == nil {
+		t.Fatal("truncated grain accepted")
+	}
+	data = append(data, make([]byte, 65536)...)
+	if _, err := verifiedStreamChecksum(bytes.NewReader(data), int64(len(data)), manifest(data)); err == nil {
+		t.Fatal("unbounded padding accepted")
+	}
+}
