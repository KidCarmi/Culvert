diff --git a/ovf/importer/stream_checksum_local.go b/ovf/importer/stream_checksum_local.go
new file mode 100644
index 0000000..ddeed86
--- /dev/null
+++ b/ovf/importer/stream_checksum_local.go
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: Apache-2.0
+package importer
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/vmware/govmomi/vapi/library"
+)
+
+// verifiedStreamChecksum supports the QEMU v3 streamOptimized layout with
+// metadata before the grain stream. ESXi hashes through the EOS sector, not
+// QEMU's trailing grain-alignment zero padding. The full file MUST still match
+// its original SHA256 manifest. No artifact or transmitted byte is changed.
+func verifiedStreamChecksum(r io.Reader, size int64, want *library.Checksum) (*library.Checksum, error) {
+	if want == nil || !strings.EqualFold(want.Algorithm, "SHA256") {
+		return nil, fmt.Errorf("SHA256 manifest required")
+	}
+	full, stream := sha256.New(), sha256.New()
+	all := io.TeeReader(r, full)
+	consumed := io.TeeReader(all, stream)
+	header := make([]byte, 512)
+	if _, err := io.ReadFull(consumed, header); err != nil {
+		return nil, err
+	}
+	le := binary.LittleEndian
+	capacity, grain := le.Uint64(header[12:20]), le.Uint64(header[20:28])
+	overhead := le.Uint64(header[64:72]) * 512
+	if le.Uint32(header[:4]) != 0x564d444b || le.Uint32(header[4:8]) != 3 ||
+		le.Uint32(header[8:12]) != 0x30003 || le.Uint16(header[77:79]) != 1 ||
+		grain != 128 || capacity == 0 || overhead < 512 || overhead > uint64(size) ||
+		le.Uint64(header[56:64]) == ^uint64(0) {
+		return nil, fmt.Errorf("unsupported streamOptimized layout")
+	}
+	if _, err := io.CopyN(io.Discard, consumed, int64(overhead)-512); err != nil {
+		return nil, err
+	}
+	offset := int64(overhead)
+	grains := 0
+	for {
+		if offset+512 > size {
+			return nil, fmt.Errorf("missing EOS sector")
+		}
+		sector := make([]byte, 512)
+		if _, err := io.ReadFull(consumed, sector); err != nil {
+			return nil, err
+		}
+		offset += 512
+		lba, n := le.Uint64(sector[:8]), le.Uint32(sector[8:12])
+		if n == 0 {
+			for _, b := range sector {
+				if b != 0 {
+					return nil, fmt.Errorf("unsupported metadata marker")
+				}
+			}
+			if grains == 0 || size-offset >= int64(grain*512) {
+				return nil, fmt.Errorf("invalid EOS or excessive trailing padding")
+			}
+			padding := make([]byte, size-offset)
+			if _, err := io.ReadFull(all, padding); err != nil {
+				return nil, err
+			}
+			for _, b := range padding {
+				if b != 0 {
+					return nil, fmt.Errorf("nonzero bytes after EOS")
+				}
+			}
+			if hex.EncodeToString(full.Sum(nil)) != strings.ToLower(want.Checksum) {
+				return nil, fmt.Errorf("full local VMDK manifest mismatch")
+			}
+			return &library.Checksum{Algorithm: "SHA256", Checksum: hex.EncodeToString(stream.Sum(nil))}, nil
+		}
+		if lba >= capacity || lba%grain != 0 || uint64(n) > grain*512+8192 {
+			return nil, fmt.Errorf("invalid grain marker")
+		}
+		remaining := ((int64(n)+12+511)/512)*512 - 512
+		if offset+remaining > size {
+			return nil, fmt.Errorf("truncated grain")
+		}
+		if _, err := io.CopyN(io.Discard, consumed, remaining); err != nil {
+			return nil, err
+		}
+		offset += remaining
+		grains++
+	}
+}
diff --git a/ovf/importer/stream_checksum_local_test.go b/ovf/importer/stream_checksum_local_test.go
