+package importer
+
+import (
+	"github.com/vmware/govmomi/nfc"
+	"github.com/vmware/govmomi/vapi/library"
+	"github.com/vmware/govmomi/vim25/types"
+	"testing"
+)
+
+func TestLocalImportChecksumTypes(t *testing.T) {
+	info := &nfc.LeaseInfo{HttpNfcLeaseInfo: types.HttpNfcLeaseInfo{DeviceUrl: []types.HttpNfcLeaseDeviceUrl{{Key: "disk-key", ImportKey: "disk-id"}}},
+		Items: []nfc.FileItem{{OvfFileItem: types.OvfFileItem{Path: "disk.vmdk", DeviceId: "disk-id"}}}}
+	manifest := map[string]*library.Checksum{"disk.vmdk": {Algorithm: "SHA256", Checksum: "unused"}}
+	pairs, err := importChecksumTypes(info, manifest)
+	if err != nil || len(pairs) != 1 || pairs[0].Key != "disk-key" || pairs[0].Value != "sha256" {
+		t.Fatalf("unexpected negotiation: %v %v", pairs, err)
+	}
+	delete(manifest, "disk.vmdk")
+	if _, err := importChecksumTypes(info, manifest); err == nil {
+		t.Fatal("missing digest accepted")
+	}
+	manifest["disk.vmdk"] = &library.Checksum{Algorithm: "SHA512"}
+	if _, err := importChecksumTypes(info, manifest); err == nil {
+		t.Fatal("unsupported algorithm accepted")
+	}
+	manifest["disk.vmdk"].Algorithm = "SHA256"
+	info.DeviceUrl[0].ImportKey = "different"
+	if _, err := importChecksumTypes(info, manifest); err == nil {
+		t.Fatal("mismatched device accepted")
+	}
+}
