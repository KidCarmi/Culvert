# Canonical install posture (FE-1A lifecycle-script experiment: PASS — see
# docs/design/FRONTEND-MIGRATION-PLAN.md §1). Dependency lifecycle scripts are
# never executed; explicit `npm run <script>` still runs (npm skips only
# pre/post hooks and dependency install scripts under ignore-scripts).
ignore-scripts=true
# Direct dependencies are exact-pinned by policy (ADR-FE-001).
save-exact=true
# The engines field is a contract, not a suggestion.
engine-strict=true
fund=false
