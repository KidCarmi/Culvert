# Explicit policy boundary for the generator workspace (FE-1A qualification
# hardening): this is a separate npm project, so the app's frontend/.npmrc
# does NOT govern installs run from this directory. Same canonical posture:
# dependency lifecycle scripts never execute. The gate scripts ALSO pass
# --ignore-scripts explicitly to every nested `npm ci` (defense in depth),
# and verify.sh proves `npm config get ignore-scripts` is true in both trees.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
