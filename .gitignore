# Compiled binaries
proxy
culvert
/Culvert

# Runtime artifacts (pid files from local/CI proxy runs)
*.pid

# Local configuration (may contain real passwords — never commit)
config.yaml

# CA bundles contain private keys
*.bundle

# Cluster CA files (generated at runtime)
cluster-ca.crt
cluster-ca.key

# Data Plane enrollment files
dp-node.crt
dp-node.key
dp_enrollment.json

# HA runtime files
cp-leader.lock
ha_config.json

# Sensitive runtime state (these live in /data volume, not in git)
data/

# Runtime-generated caches written to the working directory by the
# binary on first start. The seed list default_categories.json IS
# tracked; these two files are mutable per-instance state and should
# never be committed.
categories.json
fileprofiles.json

# Atomic-write temp files
*.tmp

# Environment files
.env
.env.*

# Editor cruft
.DS_Store
coverage.out
cover.out
