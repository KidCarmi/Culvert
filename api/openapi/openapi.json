    },
    "/api/ca/rotate": {
      "post": {
        "description": "Forces a CA rotation using a two-step confirmation-token flow: the first\nPOST returns `{status:\"pending_confirmation\", confirmation_token}` and\nemits a `ca.rotate_requested` audit event; re-POSTing with the token\napplies the rotation and emits `ca.rotate`. Re-signs future leaf\ncertificates under a new root; clients that pinned the previous root will\nfail until they re-trust. Admin-only and audited.\n",
        "operationId": "rotateCA",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "confirmation_token": "abc123",
                  "status": "pending_confirmation"
                },
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Rotation requested (`status:pending_confirmation` with a token) or\napplied, depending on whether a valid confirmation token was supplied.\n"
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          },
          "500": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Rotation failed. Body is plain text."
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "Force rotation of the internal CA (DESTRUCTIVE)",
        "tags": [
          "security"
        ],
        "x-culvert-audit-event": "ca.rotate",
        "x-culvert-danger-level": "high",
        "x-culvert-idempotency": "non-idempotent",
        "x-culvert-introduced-version": "1.0.0",
        "x-culvert-permission": "admin",
        "x-culvert-stability": "stable",
        "x-culvert-tenant-scope": "appliance",
        "x-culvert-visibility": "admin-supported"
      }
    },
    "/api/ca/status": {
      "get": {
        "description": "Returns internal CA state — root info, leaf cache, rotation, and dual-CA status.",
        "operationId": "getCAStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CAStatus"
                }
              }
            },
            "description": "CA state."
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "Internal CA status",
        "tags": [
          "security"
        ],
        "x-culvert-idempotency": "safe",
        "x-culvert-introduced-version": "1.0.0",
        "x-culvert-permission": "viewer",
        "x-culvert-stability": "stable",
        "x-culvert-tenant-scope": "appliance",
        "x-culvert-visibility": "admin-supported"
      }
    },
    "/api/config/export": {
      "get": {
        "description": "Returns the complete configuration backup envelope. May contain secrets\n(session HMAC, IdP secrets, upstream credentials). Admin-only and audited.\n",
        "operationId": "exportConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigBackup"
                }
              }
            },
            "description": "Configuration backup."
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "Export the full configuration backup (SENSITIVE)",
        "tags": [
