      "get": {
        "description": "Unauthenticated health check for load balancers. Returns 200 with\n`status:ok` when this node is standalone or the HA leader; returns 503\nwith `status:standby` on a non-leader HA node.\n",
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "leader": true,
                  "role": "standalone",
                  "status": "ok",
                  "write_authority": true
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Node is healthy and holds (or does not require) write authority."
          },
          "405": {
            "$ref": "#/components/responses/PlainMethodNotAllowed"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "leader": false,
                  "role": "standby",
                  "status": "standby",
                  "write_authority": false
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "HA standby node — not currently the writable leader."
          }
        },
        "security": [],
        "summary": "Node liveness/health probe",
        "tags": [
          "health"
        ],
