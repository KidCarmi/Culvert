                }
              }
            },
            "description": "User created or updated."
          },
          "400": {
            "$ref": "#/components/responses/PlainBadRequest"
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "Create or update an admin user",
        "tags": [
