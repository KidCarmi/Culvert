            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "ok": true
                },
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "User removed."
          },
          "400": {
            "$ref": "#/components/responses/PlainBadRequest"
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "Delete an admin user",
        "tags": [
          "auth"
        ],
        "x-culvert-audit-event": "auth.user.delete",
        "x-culvert-danger-level": "high",
        "x-culvert-idempotency": "idempotent",
        "x-culvert-introduced-version": "1.0.0",
        "x-culvert-permission": "admin",
        "x-culvert-stability": "stable",
        "x-culvert-tenant-scope": "appliance",
        "x-culvert-visibility": "admin-supported"
      },
      "get": {
        "description": "Returns all admin UI users (without password material).",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "users": [
                    {
                      "role": "admin",
                      "username": "admin"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            },
            "description": "User list."
          },
          "403": {
            "$ref": "#/components/responses/PlainForbidden"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "basicAuth": []
          }
        ],
        "summary": "List admin users",
        "tags": [
          "auth"
        ],
        "x-culvert-idempotency": "safe",
        "x-culvert-introduced-version": "1.0.0",
        "x-culvert-permission": "admin",
        "x-culvert-stability": "stable",
        "x-culvert-tenant-scope": "appliance",
        "x-culvert-visibility": "admin-supported"
      },
      "post": {
        "description": "Creates a new admin user or updates an existing one's password/role. Admin-only and audited.",
        "operationId": "upsertUser",
